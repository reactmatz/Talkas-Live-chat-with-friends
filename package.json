{
  "name": "talkas",
  "productName": "Talkas",
  "version": "0.1.0",
  "description": "Self-hosted, offline-first P2P voice, video and screen sharing with a Discord-like UI.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n web,main,app -c green,blue,cyan \"vite\" \"tsc -p electron/tsconfig.json --watch --preserveWatchOutput\" \"wait-on tcp:5180 file:dist-electron/electron/main.js && electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -b && tsc -p electron/tsconfig.json --noEmit"
  },
  "build": {
    "appId": "dev.reactmatz.talkas",
    "productName": "Talkas",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Talkas-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Voice chat",
        "NSCameraUsageDescription": "Video chat"
      }
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "wait-on": "^9.5.1"
  },
  "author": "reactmatz",
  "homepage": "https://github.com/reactmatz/Talkas-Live-chat-with-friends"
}
